# Supabase — URL e chiavi del progetto (valori reali in .env.local, mai committati)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role: SOLO server-side, mai nel browser (bypassa la RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Connessione Postgres diretta all'istanza locale — SOLO per i test di schema/RLS
# (PostgREST non espone i cataloghi di sistema). Esempio locale:
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Nome del brand (pubblico, configurabile) — default "Belora" se assente
NEXT_PUBLIC_BRAND_NAME=
